{% comment %}
  Custom Container Section with Dynamic Sections
  Description: A container section with dynamic columns, each able to include any Shopify section selected from a dropdown.
  Usage: Add to Shopify theme's 'sections' directory. Use in theme editor to add columns and select sections.
{% endcomment %}

{% style %}
  .custom-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    padding: 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .column {
    padding: 20px;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    background: #fff;
  }

  /* Ensure nested sections inherit proper styling */
  .column :where(.section) {
    margin: 0;
    padding: 0;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .custom-container {
      grid-template-columns: 1fr;
      padding: 10px;
    }

    .column {
      padding: 15px;
    }
  }
{% endstyle %}

<div class="custom-container">
  {% for block in section.blocks %}
    <div class="column" {{ block.shopify_attributes }}>
      {% if block.settings.section_picker != blank %}
        {% comment %} Render the selected section using a case statement {% endcomment %}
        {% case block.settings.section_picker %}
          {% when 'image-banner' %}
            {% section 'image-banner' %}
          {% when 'rich-text' %}
            {% section 'rich-text' %}
          {% when 'featured-collection' %}
            {% section 'featured-collection' %}
          {% when 'multicolumn' %}
            {% section 'multicolumn' %}
          {% else %}
            <p style="text-align: center;">Selected section is not supported.</p>
        {% endcase %}
      {% else %}
        <p style="text-align: center;">Select a section for this column in the theme editor.</p>
      {% endif %}
    </div>
  {% endfor %}
</div>

{% if section.blocks.size == 0 %}
  <div class="custom-container">
    <div class="column">
      <p style="text-align: center;">Add columns and select sections in the theme editor to customize this section.</p>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Custom Container",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Custom Container"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "select",
          "id": "section_picker",
          "label": "Select Section",
          "options": [
            {
              "value": "",
              "label": "None"
            },
            {
              "value": "image-banner",
              "label": "Image Banner"
            },
            {
              "value": "rich-text",
              "label": "Rich Text"
            },
            {
              "value": "featured-collection",
              "label": "Featured Collection"
            },
            {
              "value": "multicolumn",
              "label": "Multicolumn"
            }
          ],
          "default": "",
          "info": "Choose a section to display in this column. To add more sections, edit the section file to include additional options and update the case statement in the Liquid code."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Container",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}